diff --git a/src/session.rs b/src/session.rs
--- a/src/session.rs
+++ b/src/session.rs
@@ -24,7 +24,8 @@ fn display_title(session: &Session) -> String {
     let title = session.title.trim();
     if title.is_empty() {
-        "Untitled".to_string()
+        "New session".to_owned()
     } else {
-        title.to_string()
+        // Keep the sidebar readable, including Unicode titles.
+        title.chars().take(80).collect()
     }
 }
diff --git a/tests/session.rs b/tests/session.rs
